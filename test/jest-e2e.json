{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "transformIgnorePatterns": ["/node_modules/(?!(uuid)/)"],
  "testTimeout": 30000
}
